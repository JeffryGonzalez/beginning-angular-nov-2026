      "seed": 1342802999,
      "version": 330,
      "versionNonce": 930074199,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794501843521,
      "link": null,
      "locked": false,
      "text": "\"one true way to handle everything that could be async\" - Observables.\n\n\"It makes the hard stuff easier and possible, it makes the easy stuff REALLY too hard.\"\n    - enter signals. Signals are not asynchronous by the way - but they allow us to do\n      reactive programming.\n\n\"NGRX store - observable global state.\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"one true way to handle everything that could be async\" - Observables.\n\n\"It makes the hard stuff easier and possible, it makes the easy stuff REALLY too hard.\"\n    - enter signals. Signals are not asynchronous by the way - but they allow us to do\n      reactive programming.\n\n\"NGRX store - observable global state.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
