      "isDeleted": false,
      "boundElements": null,
      "updated": 1794501585532,
      "link": null,
      "locked": false,
      "text": "Select * from customers where state = 'OH' and outstanding > 3000;\n\nCURSOR (current set of records)\n\n\nReactive Extensions -\n    - subject - something that you observe\n    - stream - the observations about that subject n+ over time.\n\n ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Select * from customers where state = 'OH' and outstanding > 3000;\n\nCURSOR (current set of records)\n\n\nReactive Extensions -\n    - subject - something that you observe\n    - stream - the observations about that subject n+ over time.\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "muaUZUHyhlqb7mTmU0h_D",
      "type": "text",
      "x": 303,
      "y": 1141,
      "width": 957,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
