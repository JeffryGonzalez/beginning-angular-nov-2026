      "updated": 1794501257910,
      "link": null,
      "locked": false,
      "text": "addUp(2,2).then(s => console.log(s));\n\nconsole.log('getting your sum');\n\n\nlet s = await addUp(10,2);\nconsole.log('The sum is ', s);\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "addUp(2,2).then(s => console.log(s));\n\nconsole.log('getting your sum');\n\n\nlet s = await addUp(10,2);\nconsole.log('The sum is ', s);\n",
