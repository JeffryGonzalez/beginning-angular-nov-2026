      "link": null,
      "locked": false,
      "text": "when angular compiled your components, it would add code\nfor things like button click (click), form submits (submit), etc.\nthat after they finished, it would check to make sure if anything needed updating\nand it would update it.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
